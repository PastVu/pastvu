.mapModuleWrapper(data-bind="with: repository[M!M]")
    h3(data-bind="text: $root.i18n('Cluster size parameters')")
    p(data-bind="text: $root.i18n('To set a new cluster size, grab the transparent rectangle on the map and drag it (or its edge) within the desired bounds. Click Save to apply the changes.')")
    .mapContainer(data-bind="css: {calculating: exe()}")
        .map
        .mapNavigation
        .clusterContainer
            .clusterRect(data-bind="style: {borderColor: changed() ? '#FF0808' : '#2daf2e', borderStyle: changed() ? 'dashed' : 'solid'}")
    dl.dl-horizontal
        dt(data-bind="text: $root.i18n('Current size:')")
        dd(data-bind="text: '' + wCurr() + ' x ' + hCurr() + ''")
    dl.dl-horizontal(data-bind="style: {display: changed() ? '' : 'none'}")
        dt(data-bind="text: $root.i18n('New size:')")
        dd(data-bind="text: '' + wNew() + ' x ' + hNew() + ''")
    .clusterButt(data-bind="style: {display: changed() ? '' : 'none'}")
        button.btn.btn-primary.btnSave(type="button", data-bind="css: {disabled: exe()}, click: save, attr: {disabled: exe()}")
            span.glyphicon.glyphicon-ok
            |  Save and start conversion
        button.btn.btn-warning.btnSave(type="button", data-bind="click: cancel")
            span.glyphicon.glyphicon-exclamation-sign
            |  Cancel
    button.btn.btn-primary.btnSave(type="button", data-bind="style: {display: changed() || isDefault() ? 'none' : ''}, click: setDefaults")
        | Reset to default
    p.clusterNote(data-bind="visible: changed(), text: $root.i18n('Changing the size rebuilds clusters of both photos and paintings.')")
    .clusterRebuild(data-bind="visible: !changed()")
        h5(data-bind="text: $root.i18n('Rebuild clusters for current size')")
        .clusterRebuildForm
            select.form-control(data-bind="options: rebuildTypes, optionsText: 'desc', optionsValue: 'id', value: rebuildType, enable: !rebuilding()")
            button.btn.btn-warning(type="button", data-bind="click: rebuild, enable: !rebuilding() && !exe()")
                span.glyphicon.glyphicon-refresh
                |  
                span(data-bind="text: rebuilding() ? $root.i18n('Rebuilding...') : $root.i18n('Rebuild clusters')")
    p(style="margin-top: 6px; margin-bottom: 0;", data-bind="style: {display: exe() && changed() ? '' : 'none'}, text: $root.i18n('Recomputing the parameters at each zoom level:')")
    .progress.progress-striped.active(data-bind="style: {display: exe() && changed() ? '' : 'none'}")
        .progress-bar.progress-bar-success(data-bind="style: {width: exePercent() + '%'}")
