doctype html
html(lang=lang || config.lang)
    head(prefix="og: http://ogp.me/ns#")
        include includes/head_meta

        link(rel="stylesheet", href='/style/common.css?__=' + config.hash)

        | <script type="text/javascript">
        //-Вставляем в скрипт сгенерированную для клиента строку глобальных переменных с изначальными данными
        != initData
        | </script>

    body
        if nojsShow
            include includes/nojs
        script(type="module", src='/js/module/app' + appName + '.js?__=' + config.hash)
